{
  "name": "bespokebehaviors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:qa": "vite --mode qa",
    "qa:emulators": "firebase emulators:start --only auth,firestore,functions",
    "qa:seed": "node scripts/seed-qa-emulators.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/access.test.js tests/academicTaskIdentity.test.js tests/behaviorAnalytics.test.js tests/reteachReport.test.js tests/sequenceStandards.test.js tests/planner.test.js tests/studentRosterImport.test.js tests/studentSupports.test.js tests/behaviorAnalysis.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.js\"",
    "verify": "npm run lint && npm test && npm run build && npm audit --omit=dev --audit-level=high && npm --prefix functions audit --omit=dev --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "firebase": "^12.16.0",
    "lucide-react": "^0.539.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.58.1",
    "react-router": "8.3.0",
    "react-select": "^5.10.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
